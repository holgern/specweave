{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specweave.dev/schemas/specweave.taskledger-bdd-export.v1.schema.json",
  "title": "SpecWeave Taskledger BDD Export v1",
  "type": "object",
  "required": ["task_id", "feature", "rules", "examples"],
  "properties": {
    "task_id": { "type": "string" },
    "feature": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "rule_id",
          "given",
          "when",
          "then",
          "acceptance_criteria",
          "tags"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "rule_id": { "type": ["string", "null"] },
          "given": { "type": "array", "items": { "type": "string" } },
          "when": { "type": "array", "items": { "type": "string" } },
          "then": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
