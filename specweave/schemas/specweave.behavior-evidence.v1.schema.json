{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specweave.dev/schemas/specweave.behavior-evidence.v1.schema.json",
  "title": "SpecWeave Taskledger Behavior Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "task_id",
    "source_report",
    "status",
    "criteria",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_by": { "const": "specweave" },
    "task_id": { "type": "string" },
    "source_report": { "type": "string" },
    "status": { "enum": ["passed", "failed"] },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "status", "bdd_ids", "evidence"],
        "properties": {
          "criterion_id": { "type": "string" },
          "status": { "type": "string" },
          "bdd_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bdd_id", "status", "tags", "name"],
        "properties": {
          "bdd_id": { "type": "string" },
          "status": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
